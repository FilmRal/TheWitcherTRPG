<a class="char-stat-button skill red-skill-card {{#if skill.isProfession}}profession{{else if skill.isPickup}}pickup{{else if skill.isLearned}}learned{{/if}}"
    data-action="rollSkill" data-skill="{{name}}" data-stat={{stat}} data-tooltip="Roll {{localize skill.label}}">
    <div class="label">
        <span>{{localize skill.label}}</span>
        <strong>{{#if (gte skill.modifiedValue 0)}}+{{skill.modifiedValue}}{{else}}{{skill.modifiedValue}}{{/if}}</strong>
    </div>
    <span class="red-roll-hint"><i class="fa-solid fa-dice-d20"></i> ROLL</span>
    {{#if (or skill.isProfession skill.isPickup skill.isLearned)}}
        <div class="skill-icons">
            {{#if skill.isProfession}}
                <span><i>{{localize 'WITCHER.skills.profession'}}</i></span>
            {{/if}}
            {{#if skill.isPickup}}
                <span><i>{{localize 'WITCHER.skills.pickup'}}</i></span>
            {{/if}}
            {{#if skill.isLearned}}
                <span><i>{{localize 'WITCHER.skills.learn'}}</i></span>
            {{/if}}
        </div>
    {{/if}}
</a>