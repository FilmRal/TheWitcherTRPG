<section class="tab {{tabs.combat.cssClass}} scrollable standard-form red-monster-combat" data-group="primary" data-tab="combat">
    <div class="red-combat-dashboard">
        <section class="red-combat-panel red-combat-overview">
            <div class="red-combat-panel-header">
                <div><span class="red-combat-kicker">COMBAT PROFILE</span><h2>{{actor.name}}</h2></div>
                <span class="red-combat-threat">{{actor.system.threat}}</span>
            </div>
            <div class="red-combat-metrics">
                <div class="red-combat-metric"><span>HP</span><strong>{{system.derivedStats.hp.value}} / {{system.derivedStats.hp.max}}</strong></div>
                <div class="red-combat-metric"><span>STAMINA</span><strong>{{system.derivedStats.sta.value}} / {{system.derivedStats.sta.max}}</strong></div>
                <div class="red-combat-metric"><span>VIGOR</span><strong>{{system.derivedStats.vigor.value}} / {{system.derivedStats.vigor.max}}</strong></div>
                <div class="red-combat-metric"><span>INITIATIVE</span><strong>{{system.stats.ref.value}}</strong></div>
            </div>
        </section>

        <section class="red-combat-panel">
            <div class="red-combat-section-title"><div><span class="red-combat-kicker">OFFENCE</span><h3>Attacks</h3></div><span class="red-combat-count">{{weapons.length}}</span></div>
            <div class="red-monster-attack-grid">
                {{#each weapons as |weapon|}}
                    <article class="red-monster-attack-card item" data-item-id="{{weapon.id}}" data-type="weapon">
                        <div class="red-monster-attack-top"><img src="{{weapon.img}}" alt="{{weapon.name}}"><div><h4>{{weapon.name}}</h4><span>{{weapon.system.type.text}}</span></div>{{#if weapon.system.equipped}}<b class="red-combat-equipped">READY</b>{{/if}}</div>
                        <div class="red-monster-attack-stats"><div><small>DAMAGE</small><strong>{{weapon.system.damage}}</strong></div><div><small>RANGE</small><strong>{{weapon.system.range}}</strong></div>{{#if weapon.system.accuracy}}<div><small>ACC</small><strong>+{{weapon.system.accuracy}}</strong></div>{{/if}}<div><small>HANDS</small><strong>{{weapon.system.hands}}</strong></div></div>
                        <div class="red-monster-attack-actions"><a class="item-roll red-attack-button"><i class="fa-solid fa-sword"></i> ATTACK</a><a class="item-chat red-item-button"><i class="fa-regular fa-message"></i></a><a class="item-display-info red-item-button"><i class="fa-solid fa-circle-info"></i></a></div>
                    </article>
                {{else}}<div class="red-combat-empty">No weapon attacks configured.</div>{{/each}}
            </div>
        </section>

        {{#if combatAbilities.length}}
            <section class="red-combat-panel">
                <div class="red-combat-section-title"><div><span class="red-combat-kicker">SPECIAL</span><h3>Abilities & Magic</h3></div><span class="red-combat-count">{{combatAbilities.length}}</span></div>
                <div class="red-monster-ability-grid">
                    {{#each combatAbilities as |ability|}}
                        <article class="red-monster-ability-card item" data-item-id="{{ability.id}}" data-type="{{ability.type}}">
                            <img src="{{ability.img}}" alt="{{ability.name}}">
                            <div class="red-monster-ability-info"><h4>{{ability.name}}</h4><span>{{ability.type}}</span>{{#if ability.system.description}}<p>{{ability.system.description}}</p>{{/if}}</div>
                            <div class="red-monster-ability-actions"><a class="item-roll red-attack-button"><i class="fa-solid fa-bolt"></i> USE</a><a class="item-chat red-item-button"><i class="fa-regular fa-message"></i></a></div>
                        </article>
                    {{/each}}
                </div>
            </section>
        {{/if}}

        <div class="red-combat-two-column">
            <section class="red-combat-panel">
                <div class="red-combat-section-title"><div><span class="red-combat-kicker">DEFENCE</span><h3>Resistances</h3></div></div>
                <div class="red-resistance-grid">
                    {{#each monsterResistances as |resistance|}}
                        <div class="red-resistance-card"><span>{{resistance.label}}</span><strong>{{resistance.value}}</strong></div>
                    {{else}}<div class="red-combat-empty">No resistance modifiers configured.</div>{{/each}}
                </div>
            </section>

            <section class="red-combat-panel">
                <div class="red-combat-section-title"><div><span class="red-combat-kicker">TRAITS</span><h3>Special Traits</h3></div><span class="red-combat-count">{{monsterTraits.length}}</span></div>
                <div class="red-monster-trait-list">
                    {{#each monsterTraits as |trait|}}
                        <article class="red-monster-trait-card"><i class="fa-solid fa-skull-crossbones"></i><div><strong>{{trait.name}}</strong>{{#if trait.description}}<p>{{trait.description}}</p>{{/if}}</div></article>
                    {{else}}<div class="red-combat-empty">No special traits configured.</div>{{/each}}
                </div>
            </section>
        </div>

        <div class="red-combat-two-column">
            <section class="red-combat-panel"><div class="red-combat-section-title"><div><span class="red-combat-kicker">CORE</span><h3>Unarmed</h3></div></div><div class="red-unarmed-grid"><div class="red-unarmed-card"><span>PUNCH</span><strong>{{system.attackStats.punch.value}}</strong><small>MELEE</small></div><div class="red-unarmed-card"><span>KICK</span><strong>{{system.attackStats.kick.value}}</strong><small>MELEE</small></div></div></section>
            <section class="red-combat-panel"><div class="red-combat-section-title"><div><span class="red-combat-kicker">DEFENCE</span><h3>Defensive Options</h3></div></div><div class="red-defense-grid">{{#each defenseOptions as |defense|}}<div class="red-defense-card"><i class="fa-solid fa-shield-halved"></i><div><strong>{{localize defense.label}}</strong><span>{{defense.modifier}}</span></div></div>{{/each}}</div></section>
        </div>

        <section class="red-combat-panel"><div class="red-combat-section-title"><div><span class="red-combat-kicker">TACTICAL</span><h3>Combat Stats</h3></div></div><div class="red-tactical-grid"><div><span>RUN</span><strong>{{system.derivedStats.run.value}}</strong></div><div><span>LEAP</span><strong>{{system.derivedStats.leap.value}}</strong></div><div><span>STUN</span><strong>{{system.derivedStats.stun.value}}</strong></div><div><span>RECOVERY</span><strong>{{system.derivedStats.rec.value}}</strong></div><div><span>WOUND THRESHOLD</span><strong>{{system.derivedStats.woundTreshold.value}}</strong></div><div><span>ENCUMBRANCE</span><strong>{{system.derivedStats.enc.value}}</strong></div></div></section>
    </div>
</section>