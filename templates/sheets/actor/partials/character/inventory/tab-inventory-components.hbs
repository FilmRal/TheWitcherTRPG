<details open>
    <summary class="list-header valuables-list-header">
        {{> "systems/TheWitcherTRPG/templates/sheets/actor/partials/character/inventory/inventory-items-summary.hbs" header=header itemType=itemType subtype=subtype hasQuantity=hasQuantity}}
    </summary>

    <ol class="list item-table item-list red-inventory-cards">
        {{#each components as |component id|}}
            <li class="item list-item draggable red-inventory-card" data-item-id="{{component.id}}">
                <div class="red-inventory-main">
                    <a class="item-display-info red-inventory-image" data-tooltip="{{localize 'WITCHER.Item.openDescription'}}">
                        <img src="{{component.img}}" alt="{{component.name}}">
                    </a>
                    <div>
                        <div class="red-inventory-title">
                            <span class="red-inventory-name">{{component.name}}</span>
                        </div>
                        <div class="red-inventory-type">{{component.system.type}}</div>
                    </div>
                    <div class="red-inventory-stack">
                        <span>{{localize "WITCHER.table.Quantity"}}</span>
                        <input class="inline-edit item-quantity" data-field="system.quantity" type="number"
                            value="{{component.system.quantity}}" data-dtype="Number" />
                    </div>
                </div>

                <div class="red-inventory-actions">
                    <a class="item-display-info red-inventory-button">
                        <i class="fa-solid fa-magnifying-glass"></i> INSPECT
                    </a>
                    <a class="item-chat red-inventory-button" data-tooltip="{{localize 'WITCHER.Item.sendToChat'}}">
                        <i class="fa-regular fa-message"></i> CHAT
                    </a>
                </div>

                <div class="invisible item-info red-inventory-details">
                    <div class="item-tags">
                        {{#if component.system.type}}
                            <span class="item-tag"><i class="fa-solid fa-gem"></i> {{component.system.type}}</span>
                        {{/if}}
                        {{#if component.system.rarity}}
                            <span class="item-tag"><i class="fa-solid fa-gem"></i> {{component.system.rarity}}</span>
                        {{/if}}
                        {{#if component.system.quantityObtainable}}
                            <span class="item-tag"><i class="fa-solid fa-dice"></i> {{component.system.quantityObtainable}}</span>
                        {{/if}}
                        {{#if component.system.forage}}
                            <span class="item-tag"><i class="fa-solid fa-dice-d20"></i> {{component.system.forage}}</span>
                        {{/if}}
                        {{#if component.system.weight}}
                            <span class="item-tag"><i class="fa-solid fa-weight-hanging"></i> {{component.system.weight}}</span>
                        {{/if}}
                        {{#if component.system.cost}}
                            <span class="item-tag"><i class="fa-solid fa-coins"></i> {{component.system.cost}}</span>
                        {{/if}}
                    </div>
                    <div class="list-item-description red-inventory-description">
                        <h3>{{localize "WITCHER.Item.Description"}}</h3>
                        <span><b>{{localize "WITCHER.Component.Location"}}:</b> {{component.system.location}}</span>
                    </div>
                </div>
            </li>
        {{/each}}
    </ol>
</details>