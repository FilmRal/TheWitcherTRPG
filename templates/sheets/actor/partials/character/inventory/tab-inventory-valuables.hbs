<details open>
    <summary class="list-header valuables-list-header">
        {{> "systems/TheWitcherTRPG/templates/sheets/actor/partials/character/inventory/inventory-items-summary.hbs" header=header itemType=itemType hasQuantity=hasQuantity}}
    </summary>

    <ol class="list item-table item-list red-inventory-cards">
        {{#each valuables as |valuable id|}}
            <li class="item list-item draggable red-inventory-card" data-item-id="{{valuable.id}}">
                <div class="red-inventory-main">
                    <a class="item-display-info red-inventory-image" data-tooltip="{{localize 'WITCHER.Item.openDescription'}}">
                        <img src="{{valuable.img}}" alt="{{valuable.name}}">
                    </a>
                    <div>
                        <div class="red-inventory-title">
                            <span class="red-inventory-name">{{valuable.name}}</span>
                        </div>
                        <div class="red-inventory-type">{{valuable.system.type}}</div>
                    </div>
                    <div class="red-inventory-stack">
                        <span>{{localize "WITCHER.table.Quantity"}}</span>
                        <input class="inline-edit item-quantity" data-field="system.quantity" type="number"
                            value="{{valuable.system.quantity}}" data-dtype="Number" />
                    </div>
                </div>

                <div class="red-inventory-actions">
                    {{#if valuable.isConsumable}}
                        <a class="item-consume red-inventory-button red-primary" data-tooltip="Consume {{valuable.name}}">
                            <i class="fa-solid fa-bottle-droplet"></i> {{localize "WITCHER.Item.consume"}}
                        </a>
                    {{/if}}
                    <a class="item-display-info red-inventory-button" data-tooltip="{{localize 'WITCHER.Item.openDescription'}}">
                        <i class="fa-solid fa-magnifying-glass"></i> {{localize "WITCHER.Item.inspect"}}
                    </a>
                    <a class="item-chat red-inventory-button" data-tooltip="{{localize 'WITCHER.Item.sendToChat'}}">
                        <i class="fa-regular fa-message"></i> {{localize "WITCHER.Item.sendToChat"}}
                    </a>
                    <a class="item-carried red-inventory-button red-carried {{#if valuable.system.isCarried}}equipped{{/if}}"
                        data-tooltip="{{#if valuable.system.isCarried}}{{localize 'WITCHER.Item.Carried'}}{{else}}{{localize 'WITCHER.Item.notCarried'}}{{/if}}">
                        <i class="{{#if valuable.system.isCarried}}fa-solid{{else}}fa-regular{{/if}} fa-hand"></i>
                        {{#if valuable.system.isCarried}}{{localize "WITCHER.Item.Carried"}}{{else}}{{localize "WITCHER.Item.notCarried"}}{{/if}}
                    </a>
                </div>

                <div class="invisible item-info red-inventory-details">
                    <div class="item-tags">
                        {{#if valuable.system.avail}}
                            <span class="item-tag">
                                <i class="fa-solid fa-magnifying-glass"></i>
                                {{localize (lookup ../config.Availability valuable.system.avail)}}
                            </span>
                        {{/if}}
                        {{#if valuable.system.conceal}}
                            <span class="item-tag">
                                <i class="fa-solid fa-eye-slash"></i>
                                {{localize (lookup ../config.Concealment valuable.system.conceal)}}
                            </span>
                        {{/if}}
                        {{#if valuable.system.weight}}
                            <span class="item-tag"><i class="fa-solid fa-weight-hanging"></i> {{valuable.system.weight}}</span>
                        {{/if}}
                        {{#if valuable.system.cost}}
                            <span class="item-tag"><i class="fa-solid fa-coins"></i> {{valuable.system.cost}}</span>
                        {{/if}}
                    </div>

                    {{#if valuable.system.description}}
                        <div class="list-item-description red-inventory-description">
                            <h3>{{localize "WITCHER.Item.Description"}}</h3>
                            {{valuable.system.description}}
                        </div>
                    {{/if}}

                    {{#if (eq valuable.type 'container')}}
                        <h3>{{localize "WITCHER.Item.containerItems"}}</h3>
                        <div class="progress-bar-stored-weight">
                            <progress value="{{valuable.system.storedWeight}}" max="{{valuable.system.carry}}"></progress>
                            <div class="progress-bar-stored-weight-labels">
                                <span>Weight: {{valuable.system.storedWeight}}</span>
                                <span class="bulk-max">Max Weight: {{valuable.system.carry}}</span>
                            </div>
                        </div>
                        <div class="container-stored-item">
                            {{#each valuable.system.itemContent as |storedItem|}}
                                <details class="stored-item" data-item-id="{{storedItem.uuid}}">
                                    <summary class="stored-item-label">
                                        <img class="stored-item-img" src="{{storedItem.img}}">
                                        <span>{{storedItem.name}}</span>
                                    </summary>
                                    <div class="stored-item-info">
                                        <div class="item-tags">
                                            <span class="item-tag"><i class="fa-solid fa-weight-hanging"></i> {{storedItem.weight}}</span>
                                        </div>
                                        {{#if storedItem.description}}
                                            <div class="list-item-description red-inventory-description">
                                                <h3>{{localize "WITCHER.Item.Description"}}</h3>
                                                {{storedItem.description}}
                                            </div>
                                        {{/if}}
                                    </div>
                                </details>
                            {{/each}}
                        </div>
                    {{/if}}
                </div>
            </li>
        {{/each}}
    </ol>
</details>