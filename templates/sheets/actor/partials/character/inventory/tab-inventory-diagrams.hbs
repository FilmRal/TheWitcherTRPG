<details open>
    <summary class="list-header valuables-list-header">
        {{> "systems/TheWitcherTRPG/templates/sheets/actor/partials/character/inventory/inventory-items-summary.hbs" header=header hasQuantity=hasQuantity}}
    </summary>
    <ol class="list item-table item-list red-inventory-cards">
        {{#each diagrams as |diagram id|}}
            <li class="item list-item draggable red-inventory-card red-diagram-card" data-item-id="{{diagram.id}}">
                <div class="red-inventory-main">
                    <a class="item-display-info red-inventory-image" data-tooltip="{{localize 'WITCHER.Item.openDescription'}}"><img src="{{diagram.img}}" alt="{{diagram.name}}"></a>
                    <div>
                        <div class="red-inventory-title"><span class="red-inventory-name">{{diagram.name}}</span>{{#if diagram.system.learned}}<span class="red-item-badge"><i class="fa-solid fa-bookmark"></i> LEARNED</span>{{/if}}</div>
                        <div class="red-inventory-type">{{localize (concat "TYPES.Item." diagram.system.type)}}</div>
                    </div>
                    <div class="red-inventory-stack"><span>{{localize "WITCHER.table.Quantity"}}</span><input class="inline-edit item-quantity" data-field="system.quantity" type="number" value="{{diagram.system.quantity}}" data-dtype="Number" /></div>
                </div>
                <div class="red-inventory-actions">
                    <a class="item-learned red-inventory-button {{#if diagram.system.learned}}equipped{{/if}}"><i class="{{#if diagram.system.learned}}fa-solid{{else}}fa-regular{{/if}} fa-bookmark"></i> {{#if diagram.system.learned}}LEARNED{{else}}LEARN{{/if}}</a>
                    <a class="crafting-craft red-inventory-button red-primary"><i class="fas fa-hammer"></i> CRAFT</a>
                    <a class="item-display-info red-inventory-button"><i class="fa-solid fa-magnifying-glass"></i> INSPECT</a>
                    <a class="item-chat red-inventory-button"><i class="fa-regular fa-message"></i> CHAT</a>
                </div>
                <div class="invisible item-info red-inventory-details">
                    <div class="item-tags">
                        {{#if diagram.system.isFormulae}}<span class="item-tag"><i class="fa-solid fa-flask"></i> {{localize "WITCHER.Diagram.alchemyDC"}} {{diagram.system.alchemyDC}}</span>{{else}}<span class="item-tag"><i class="fa-solid fa-dice-d20"></i> {{localize "WITCHER.Diagram.craftingDC"}} {{diagram.system.craftingDC}}</span>{{/if}}
                        <span class="item-tag"><i class="fa-solid fa-screwdriver"></i> {{localize (lookup ../config.craftingLevels diagram.system.level)}}</span>
                        <span class="item-tag"><i class="fa-solid fa-clock"></i> {{diagram.system.craftingTime}}</span>
                        <span class="item-tag"><i class="fa-solid fa-coins"></i> {{diagram.system.cost}}</span>
                        <span class="item-tag"><i class="fa-solid fa-arrow-trend-up"></i> {{diagram.system.investment}}</span>
                    </div>
                    {{#if diagram.system.description}}<div class="list-item-description red-inventory-description"><h3>{{localize "WITCHER.Item.Description"}}</h3>{{{diagram.system.description}}}</div>{{/if}}
                    {{#if (or diagram.system.craftingComponents diagram.system.alchemyComponents)}}<h3>{{localize "WITCHER.Diagram.components"}}</h3>{{/if}}
                    {{#if diagram.system.craftingComponents}}<div class="red-component-grid">{{#each diagram.system.craftingComponents as |component name|}}<div class="red-component-row"><img src="{{component.img}}"><span>{{component.name}}</span><b>{{getOwnedComponentCount ../../actor component.name}} / {{component.quantity}}</b></div>{{/each}}</div>{{/if}}
                    {{#if diagram.system.isFormulae}}<div class="red-component-grid">{{#each ../alchemyComponentsList as |component|}}{{#if (lookup diagram.system.alchemyComponents component.key)}}<div class="red-component-row"><img src="systems/TheWitcherTRPG/assets/images/{{component.image}}"><span>{{localize (concat "WITCHER.Inventory." component.label)}}</span><b>{{count}} / {{lookup diagram.system.alchemyComponents component.key}}</b></div>{{/if}}{{/each}}</div>{{/if}}
                </div>
            </li>
        {{/each}}
    </ol>
</details>