<details open class="red-weapon-list">
    <summary class="list-header weapon-header">
        {{> "systems/TheWitcherTRPG/templates/sheets/actor/partials/character/inventory/inventory-items-summary.hbs" header=header itemType=itemType hasDamage=hasDamage hasReliability=hasReliability}}
    </summary>
    <ol class="list item-table item-list red-weapon-cards">
        {{#each weapons as |weapon id|}}
            <li class="item draggable red-weapon-card" data-item-id="{{weapon.id}}" data-type="weapon">
                <div class="red-weapon-main">
                    <a class="item-weapon-display display-details red-weapon-image" title="{{localize 'WITCHER.Item.openDescription'}}">
                        <img class="item-image" src="{{weapon.img}}">
                    </a>
                    <div class="red-weapon-info">
                        <div class="red-weapon-title-row">
                            <a class="item-roll red-weapon-name">{{weapon.name}}</a>
                            {{#if weapon.system.equipped}}<span class="red-equipped"><i class="fa-solid fa-hand"></i> EQUIPPED</span>{{/if}}
                        </div>
                        <div class="red-weapon-tags">
                            <span><i class="fa-solid fa-crosshairs"></i> {{weapon.system.type.text}}</span>
                            <span><i class="fa-solid fa-ruler"></i> {{weapon.system.range}}</span>
                            {{#if weapon.system.accuracy}}<span><i class="fa-solid fa-bullseye"></i> +{{weapon.system.accuracy}}</span>{{/if}}
                            <span><i class="fa-solid fa-weight-hanging"></i> {{weapon.system.weight}}</span>
                        </div>
                    </div>
                    <div class="red-weapon-damage">
                        <small>DAMAGE</small>
                        <strong>{{weapon.system.damage}}</strong>
                    </div>
                </div>
                <div class="red-weapon-actions">
                    <a class="item-roll red-attack-button"><i class="fa-solid fa-sword"></i> ATTACK</a>
                    <a class="item-chat red-item-button" data-tooltip="{{localize 'WITCHER.Item.sendToChat'}}"><i class="fa-regular fa-message"></i></a>
                    <a class="item-equip red-item-button {{#if weapon.system.equipped}}equipped{{/if}}" data-tooltip="{{#if weapon.system.equipped}}{{localize 'WITCHER.Item.Equipped'}}{{else}}{{localize 'WITCHER.Item.NotEquipped'}}{{/if}}"><i class="{{#if weapon.system.equipped}}fa-solid{{else}}fa-regular{{/if}} fa-hand"></i></a>
                    {{#if weapon.system.canBeRepaired}}
                        <a class="item-repair red-item-button" data-tooltip="{{localize 'WITCHER.Repair.buttons.repair'}}"><i class="fas fa-screwdriver-wrench"></i></a>
                    {{/if}}
                </div>
                <div class="invisible item-info list-item-info red-weapon-details">
                    <div class="item-tags">
                        <span class="item-tag">{{weapon.system.type.text}}</span>
                        <span class="item-tag"><i class="fa-solid fa-ruler"></i> {{weapon.system.range}}</span>
                        {{#if weapon.system.accuracy}}<span class="item-tag"><i class="fa-solid fa-crosshairs"></i> +{{weapon.system.accuracy}}</span>{{/if}}
                        <span class="item-tag"><i class="fa-solid fa-hand"></i> {{ localize (lookup ../config.weapon.hands weapon.system.hands) }}</span>
                        <span class="item-tag"><i class="fa-solid fa-eye-slash"></i> {{ localize (lookup ../config.Concealment weapon.system.conceal) }}</span>
                        <span class="item-tag"><i class="fa-solid fa-weight-hanging"></i> {{weapon.system.weight}}</span>
                    </div>
                    {{#if weapon.system.description}}
                        <div class="list-item-description">
                            <h3>{{localize "WITCHER.Item.Description"}}</h3>
                            {{weapon.system.description}}
                        </div>
                    {{/if}}
                </div>
            </li>
        {{/each}}
    </ol>
</details>